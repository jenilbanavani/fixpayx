<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#0C1422">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingLeft="20dp" android:paddingRight="20dp"
        android:paddingTop="34dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="34dp">
            <TextView android:layout_width="44dp" android:layout_height="44dp" android:gravity="center"
                android:background="@drawable/logo_bg" android:text="Q" android:textColor="#09251A"
                android:textStyle="bold" android:textSize="23sp"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginLeft="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PayQR" android:textColor="#F5F8FC" android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Simple UPI payment QR" android:textColor="#A1AFC2" android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/setupPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="22dp" android:background="@drawable/panel_bg">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Let's set up PayQR." android:textColor="#F5F8FC" android:textSize="28sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginBottom="22dp"
                android:text="Enter your shop's UPI ID once. That's it." android:textColor="#A1AFC2" android:textSize="14sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="YOUR UPI ID" android:textColor="#DCE6F2" android:textStyle="bold" android:textSize="12sp"/>
            <EditText android:id="@+id/upiInput" android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_marginTop="8dp" android:paddingLeft="14dp" android:paddingRight="14dp"
                android:singleLine="true" android:inputType="textEmailAddress" android:hint="shopname@bank"
                android:textColor="#F5F8FC" android:textColorHint="#718198" android:background="@drawable/input_bg"/>
            <Button android:id="@+id/saveUpi" android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_marginTop="17dp" android:text="Save and continue" android:textAllCaps="false"
                android:textStyle="bold" android:textColor="#09251A" android:background="@drawable/button_bg"/>
            <TextView android:id="@+id/setupError" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFAAA5" android:textSize="12sp" android:layout_marginTop="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="You only do this once on this phone."
                android:textColor="#A1AFC2" android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/generatorPanel" android:visibility="gone"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="22dp" android:background="@drawable/panel_bg">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="How much should they pay?" android:textColor="#F5F8FC" android:textSize="27sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginBottom="22dp"
                android:text="Enter the amount. PayQR makes your QR code." android:textColor="#A1AFC2" android:textSize="14sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="AMOUNT IN RUPEES" android:textColor="#DCE6F2" android:textStyle="bold" android:textSize="12sp"/>
            <EditText android:id="@+id/amountInput" android:layout_width="match_parent" android:layout_height="68dp"
                android:layout_marginTop="8dp" android:paddingLeft="16dp" android:paddingRight="14dp"
                android:singleLine="true" android:inputType="numberDecimal" android:hint="₹  0"
                android:textSize="30sp" android:textStyle="bold" android:textColor="#F5F8FC"
                android:textColorHint="#718198" android:background="@drawable/input_bg"/>
            <Button android:id="@+id/makeQr" android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_marginTop="17dp" android:text="Make payment QR" android:textAllCaps="false"
                android:textStyle="bold" android:textColor="#09251A" android:background="@drawable/button_bg"/>
            <LinearLayout android:id="@+id/resultPanel" android:visibility="gone"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <ImageView android:id="@+id/qrImage" android:layout_width="250dp" android:layout_height="250dp"
                    android:layout_gravity="center_horizontal" android:layout_marginTop="22dp"
                    android:padding="10dp" android:background="#FFFFFF" android:contentDescription="UPI payment QR code"/>
                <TextView android:id="@+id/qrAmount" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:textColor="#F5F8FC" android:textSize="22sp"
                    android:textStyle="bold" android:layout_marginTop="12dp"/>
                <TextView android:id="@+id/qrUpi" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:textColor="#A1AFC2" android:textSize="12sp" android:layout_marginTop="4dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="15dp">
                    <Button android:id="@+id/downloadQr" android:layout_width="0dp" android:layout_height="52dp"
                        android:layout_weight="1" android:text="Download" android:textAllCaps="false"
                        android:textColor="#09251A" android:textStyle="bold" android:background="@drawable/button_bg"/>
                    <Button android:id="@+id/shareQr" android:layout_width="0dp" android:layout_height="52dp"
                        android:layout_weight="1" android:layout_marginLeft="9dp" android:text="Share"
                        android:textAllCaps="false" android:textColor="#F5F8FC" android:background="@drawable/secondary_button_bg"/>
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:padding="12dp" android:background="@drawable/warning_bg"
                android:text="This QR pre-fills the amount. Some UPI apps may still let the customer change it. A guaranteed fixed amount needs a payment provider's dynamic QR."
                android:textColor="#F0D9A2" android:textSize="12sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="17dp">
                <TextView android:id="@+id/savedUpi" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textColor="#A1AFC2" android:textSize="12sp"/>
                <Button android:id="@+id/changeUpi" android:layout_width="wrap_content" android:layout_height="42dp"
                    android:text="Change" android:textAllCaps="false" android:textColor="#79E4B7"
                    android:background="@android:color/transparent"/>
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:layout_marginTop="20dp" android:text="PayQR · Payments go directly to your UPI account"
            android:textColor="#718198" android:textSize="11sp"/>
    </LinearLayout>
</ScrollView>
